{
  "expo": {
    "name": "FootPrint",
    "slug": "footprint-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "footprint",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aqrava.footprint",
      "infoPlist": {
        "NSCameraUsageDescription": "FootPrint needs camera access to capture photos for your memories.",
        "NSPhotoLibraryUsageDescription": "FootPrint needs photo library access to save and share your memories.",
        "NSMicrophoneUsageDescription": "FootPrint needs microphone access to record voice notes for your memories.",
        "NSLocationWhenInUseUsageDescription": "FootPrint uses your location to tag where your memories were created.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FootPrint uses your location to tag where your memories were created.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B7DE9"
      },
      "package": "com.aqrava.footprint",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "5fc5406d-e8ab-4ce1-98e6-03fbd34dc1e8"
      }
    },
    "owner": "hamid.naser",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2B7DE9"
        }
      ],
      "expo-audio",
      "expo-video"
    ]
  }
}
